# Copy to .env.local (gitignored) for the Storybook AI prototype — the Review step's AI marks.
# Read only by the Storybook dev server (.storybook/improve-copy.ts); never sent to the browser.
# On Netlify, set the same variables under Site configuration → Environment variables instead.
# Leave ANTHROPIC_API_KEY unset if you've run `ant auth login` instead.
ANTHROPIC_API_KEY=
# Optional — defaults to claude-opus-5-5.
ANTHROPIC_MODEL=
